+        os.remove(upload)
+        return refused(plain(error) if isinstance(error, ValueError) else "that file is not a zip, or it did not arrive whole")
+    os.replace(staging, os.path.join(root(), made))
+    os.remove(upload)
+    async with lock(made):
+        commit(made, archiver.adopt(data, old, made, title), "import archive", body.get("client_id"))
+    return web.json_response({"folder": made, "project": read_project(made), "from": old, "mode": manifest.get("mode")})
+
