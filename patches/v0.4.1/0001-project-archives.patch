+# Archives. A project packed into one zip to download, and a zip uploaded in parts to open as a project,
+# so a cloud machine with no lasting disk can pick up where the last one stopped.
+
+INCOMING = ".incoming"
+ARCHIVE_PART = 64 * 1024 * 1024      # the most one upload request may carry; proxies in front of pods cap request bodies
+ARCHIVE_KEPT = 24 * 3600             # an upload nobody finished is cleared after a day
+UPLOAD_ID = re.compile(r"^[0-9a-f]{32}$")
+
+
+def pack_version():
+    try:
+        import tomllib
+
+        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "pyproject.toml"), "rb") as f:
+            return tomllib.load(f)["project"]["version"]
+    except Exception:
+        return ""
+
+
+async def archive_sizes(request):
+    """How large the archive of a project is for each choice of what to carry, before it is made."""
