+class _ResponseSink:
+    """A file-like object a zip writer in a worker thread writes into, sent on to the browser as it comes."""
+
+    def __init__(self, response, loop):
+        self.response, self.loop, self.buffer = response, loop, bytearray()
+
+    def write(self, chunk):
+        self.buffer += chunk
+        if len(self.buffer) >= 1 << 20:
+            self.flush()
+        return len(chunk)
+
+    def flush(self):
+        if self.buffer:
+            block, self.buffer = bytes(self.buffer), bytearray()
+            asyncio.run_coroutine_threadsafe(self.response.write(block), self.loop).result()
+
+
+async def archive(request):
+    """Download a project as a zip. It streams as it is packed, so a large project starts arriving at once."""
+    folder = store.slug(request.match_info["name"])
+    mode = request.query.get("mode", "timeline")
+    if mode not in archiver.MODES:
+        return refused("mode is one of %s" % ", ".join(archiver.MODES))
+    async with lock(folder):
+        data = read_project(folder)
+    title = store.slug(data.get("name") or folder)
+    response = web.StreamResponse(headers={
+        "Content-Type": "application/zip",
+        "Content-Disposition": 'attachment; filename="%s.h3project.zip"' % title,
+        "Cache-Control": "no-store", "X-Accel-Buffering": "no"})
+    response.enable_chunked_encoding()
+    await response.prepare(request)
+    loop = asyncio.get_running_loop()
+    sink = _ResponseSink(response, loop)
+
+    def pack():
+        archiver.write_archive(sink, os.path.join(root(), folder), folder, data, mode, pack_version())
+        sink.flush()
+
+    try:
+        await loop.run_in_executor(None, pack)
+    except (ConnectionResetError, asyncio.CancelledError):
+        logging.info("[H3 Editor] the download of %s stopped before it finished", folder)
+        raise
+    await response.write_eof()
+    return response
+
+
+def incoming(upload_id):
+    if not UPLOAD_ID.match(upload_id or ""):
+        raise web.HTTPBadRequest(text="upload ids are 32 hex characters")
+    path = os.path.join(root(), INCOMING)
+    os.makedirs(path, exist_ok=True)
+    return os.path.join(path, upload_id + ".zip")
+
+
+def clear_incoming():
+    path = os.path.join(root(), INCOMING)
+    if not os.path.isdir(path):
+        return
+    for name in os.listdir(path):
+        full = os.path.join(path, name)
+        try:
+            if time.time() - os.path.getmtime(full) > ARCHIVE_KEPT:
+                shutil.rmtree(full) if os.path.isdir(full) else os.remove(full)
+        except OSError:
+            pass
+
+
+async def archive_part(request):
+    """One part of an archive being uploaded. Parts come in order; `offset` says where this one starts."""
+    target = incoming(request.query.get("id"))
+    offset = int(request.query.get("offset", 0))
+    if offset == 0:
+        await asyncio.get_running_loop().run_in_executor(None, clear_incoming)
+        if os.path.exists(target):
+            os.remove(target)
+    have = os.path.getsize(target) if os.path.exists(target) else 0
+    if offset != have:
+        return refused("this part starts at byte %d, the upload has %d" % (offset, have), 409, have=have)
+    written = 0
+    with open(target, "ab") as f:
+        async for chunk in request.content.iter_chunked(1 << 20):
+            written += len(chunk)
+            if written > ARCHIVE_PART:
+                f.truncate(offset)
+                return refused("send parts of at most %d MB" % (ARCHIVE_PART // (1 << 20)), 413)
+            f.write(chunk)
+    return web.json_response({"have": offset + written})
+
