index 0000000..84ffe21
--- /dev/null
+++ b/archive.py
@@ -0,0 +1,208 @@
+"""Project archives: one project folder packed into a zip to take away, and a zip unpacked into a new project.
+
+A project is a folder inside h3take_projects. An archive holds that folder under its own name, with a
+small manifest beside project.json, so it can be opened again on another machine or a fresh cloud pod.
+No Comfy import, so the packing rules can be tested on their own.
+"""
+
+import copy
+import json
+import os
+import re
+import shutil
+import stat
+import zipfile
+
+try:
+    from . import project as store
+except ImportError:
+    import project as store
+
+FORMAT = 1
+MANIFEST = "h3-archive.json"
+# What a project folder holds that an archive leaves out: revisions start afresh, like a duplicate.
+SKIPPED_FOLDERS = ("history",)
+SKIPPED_ENDINGS = (".tmp",)
+# Renders are already compressed, so they are stored as they are and an archive packs fast.
+STORED = (".mp4", ".mov", ".webm", ".mkv", ".jpg", ".jpeg", ".png", ".webp", ".mp3", ".m4a", ".ogg", ".flac",
+          ".safetensors")
+MODES = {
+    "all": "Everything: every take, the exports and the pictures",
+    "timeline": "The takes the timeline shows, footage and pictures",
+    "none": "No renders: the shots, cast, pictures, sound and footage",
+}
+TAKE_ID = re.compile(r"t[0-9a-f]{8}")
+
+
+def _owners(project):
+    """Everything that has takes: clips, and VFX clips."""
+    return list(project.get("clips") or []) + list(project.get("effects") or [])
+
+
+def _keeps(project, owner, take, mode, shown):
+    if mode == "all" or take.get("quality") == "footage":
+        # Footage came from the person, not from a render, so it can never be made again.
+        return True
+    if mode == "none":
+        return False
+    active = store.active_take(owner)
+    return bool(active) and active.get("id") == take.get("id") and owner.get("id") in shown
+
+
+def pack_plan(project, mode):
+    """The project as the archive will hold it, and the ids of the takes it leaves out."""
+    if mode not in MODES:
+        raise ValueError("mode is one of %s" % ", ".join(MODES))
+    data = copy.deepcopy(project)
+    data["pending"] = []
+    data.pop("revision", None)
+    # A VFX clip draws over the cut by itself; a clip shows only when an item on the timeline points at it.
+    shown = {item.get("clip") for item in data.get("timeline") or []}
+    shown.update(effect.get("id") for effect in data.get("effects") or [])
+    dropped = set()
+    for owner in _owners(data):
+        takes = owner.get("takes") or []
+        kept = [t for t in takes if _keeps(project, owner, t, mode, shown)]
+        dropped.update(t["id"] for t in takes if t not in kept and t.get("id"))
+        if len(kept) != len(takes):
+            owner["takes"] = kept
+            if not any(t.get("id") == owner.get("active") for t in kept):
+                owner["active"] = kept[-1]["id"] if kept else None
+    return data, dropped
+
+
+def _left_out(relative, dropped, mode):
+    parts = relative.split("/")
+    if parts[0] in SKIPPED_FOLDERS or relative.endswith(SKIPPED_ENDINGS) or parts[-1] in ("project.json", MANIFEST):
+        return True
+    if parts[0] == "exports" and mode != "all":
+        return True
+    if parts[0] == "clips" and dropped:
+        # Every file a render leaves (the video, its poster, strip, sound peaks, held latent) carries its take's id.
+        return any(found in dropped for found in TAKE_ID.findall(parts[-1]))
+    return False
+
+
+def pack_files(folder_path, dropped, mode):
+    """(path on disk, path inside the project folder) for every file the archive carries."""
+    found = []
+    for base, folders, files in os.walk(folder_path):
+        folders[:] = sorted(f for f in folders if not os.path.islink(os.path.join(base, f)))
+        for name in sorted(files):
+            path = os.path.join(base, name)
+            if os.path.islink(path) or not os.path.isfile(path):
+                continue
+            relative = os.path.relpath(path, folder_path).replace(os.sep, "/")
+            if not _left_out(relative, dropped, mode):
+                found.append((path, relative))
+    return found
+
+
+def pack_size(files):
+    return sum(os.path.getsize(path) for path, _ in files)
+
+
+def write_archive(out, folder_path, folder, project, mode, version=""):
+    """Write the zip to `out`, which can be a stream that cannot seek, such as an HTTP response."""
+    data, dropped = pack_plan(project, mode)
+    files = pack_files(folder_path, dropped, mode)
+    manifest = {"format": FORMAT, "folder": folder, "name": data.get("name") or folder, "mode": mode,
+                "editor": version, "files": len(files), "bytes": pack_size(files), "left_out_takes": len(dropped)}
+    with zipfile.ZipFile(out, "w", allowZip64=True) as archive:
+        archive.writestr(folder + "/" + MANIFEST, json.dumps(manifest, indent=1), zipfile.ZIP_DEFLATED)
+        archive.writestr(folder + "/project.json", json.dumps(data, indent=1), zipfile.ZIP_DEFLATED)
+        for path, relative in files:
+            method = zipfile.ZIP_STORED if relative.lower().endswith(STORED) else zipfile.ZIP_DEFLATED
+            archive.write(path, folder + "/" + relative, method)
+    return manifest
+
+
+# Opening an archive.
+
+def _guess_folder(data):
+    """The folder a project's paths point into, for an archive made without a manifest."""
+    counts = {}
+
+    def walk(value):
+        if isinstance(value, dict):
+            for inner in value.values():
+                walk(inner)
+        elif isinstance(value, list):
+            for inner in value:
+                walk(inner)
+        elif isinstance(value, str):
+            match = re.match(r"%s[/\\]([^/\\]+)" % re.escape(store.ROOT), value)
+            if match:
+                counts[match.group(1)] = counts.get(match.group(1), 0) + 1
+
+    walk(data)
+    return max(counts, key=counts.get) if counts else None
+
+
+def _safe(name):
+    parts = name.replace("\\", "/").split("/")
+    return not (name.startswith(("/", "\\")) or re.match(r"^[A-Za-z]:", name) or ".." in parts)
+
+
+def find_project(archive):
+    """The folder inside the zip that holds project.json, as a prefix ending in / (or "" at the top)."""
+    names = [n for n in archive.namelist() if n.replace("\\", "/").split("/")[-1] == "project.json"]
+    names = [n for n in names if "/history/" not in n.replace("\\", "/")]
+    if not names:
+        raise ValueError("that zip has no project.json, so it is not an H3 Editor project")
+    # The shallowest one is the project; Colab's tars put it under h3take_projects/<name>/.
+    best = min(names, key=lambda n: n.replace("\\", "/").count("/"))
+    return best.replace("\\", "/")[: -len("project.json")]
+
+
+def unpack(zip_path, staging):
+    """Unpack the project in a zip into `staging`. Returns the project, its old folder and the manifest."""
+    with zipfile.ZipFile(zip_path) as archive:
+        prefix = find_project(archive)
+        try:
+            data = json.loads(archive.read(prefix + "project.json").decode("utf-8"))
+        except (KeyError, ValueError, UnicodeDecodeError):
+            raise ValueError("the project.json in that zip cannot be read")
+        if not isinstance(data, dict) or not isinstance(data.get("clips", []), list):
+            raise ValueError("the project.json in that zip is not an H3 Editor project")
+        manifest = {}
+        if prefix + MANIFEST in archive.namelist():
+            try:
+                manifest = json.loads(archive.read(prefix + MANIFEST).decode("utf-8"))
+            except ValueError:
+                manifest = {}
+        if int(manifest.get("format") or FORMAT) > FORMAT:
+            raise ValueError("that archive comes from a newer H3 Editor. Update this one to open it")
+        need = sum(i.file_size for i in archive.infolist())
+        free = shutil.disk_usage(os.path.dirname(os.path.abspath(staging)) or ".").free
+        if need > free:
+            raise ValueError("unpacking needs %.1f GB and the disk has %.1f GB free" % (need / 1e9, free / 1e9))
+        os.makedirs(staging, exist_ok=True)
+        top = os.path.realpath(staging)
+        for info in archive.infolist():
+            name = info.filename.replace("\\", "/")
+            if not name.startswith(prefix) or name.endswith("/"):
+                continue
+            relative = name[len(prefix):]
+            parts = relative.split("/")
+            if parts[-1] in ("project.json", MANIFEST) and len(parts) == 1 or parts[0] in SKIPPED_FOLDERS:
+                continue
+            if not _safe(relative) or stat.S_ISLNK(info.external_attr >> 16):
+                raise ValueError("that zip has a file outside its project folder (%s)" % info.filename)
+            target = os.path.realpath(os.path.join(staging, relative))
+            if not target.startswith(top + os.sep):
+                raise ValueError("that zip has a file outside its project folder (%s)" % info.filename)
+            os.makedirs(os.path.dirname(target), exist_ok=True)
+            with archive.open(info) as source, open(target, "wb") as sink:
+                shutil.copyfileobj(source, sink, 1 << 20)
+    old = manifest.get("folder") or _guess_folder(data) or prefix.strip("/").split("/")[-1] or None
+    return data, old, manifest
+
+
+def adopt(data, old, new, title):
+    """An unpacked project, pointed at the folder it now lives in and ready to be committed as revision 1."""
+    made = store.retarget(data, old, new) if old and old != new else copy.deepcopy(data)
+    made["name"] = title
+    made["pending"] = []
+    made.pop("revision", None)
+    return made
