+// Archives: a project as one zip to take away, and a zip opened as a project again. The download is a plain
+// link, so the browser streams it to disk however large it is. The upload goes in parts, because the proxies
+// in front of cloud machines refuse large requests, and a part that fails is sent again.
+
+const ARCHIVE_PART = 32 * 1024 * 1024;
+const archiveSize = (bytes) => bytes >= 1e9 ? (bytes / 1e9).toFixed(1) + " GB" : Math.max(0.1, bytes / 1e6).toFixed(1) + " MB";
+
+function archiveLink(mode) {
+  $("archiverGo").href = "/h3take/api/project/" + encodeURIComponent(state.folder) + "/archive?mode=" + mode;
+}
+
+$("projectDownload").addEventListener("click", async () => {
+  const dialog = $("archiver");
+  const modes = $("archiverModes");
+  $("archiverNote").textContent = "Measuring the project.";
+  $("archiverGo").setAttribute("aria-disabled", "true");
+  modes.replaceChildren();
+  dialog.showModal();
+  try {
+    await flush();
+    const { modes: labels, sizes } = await api("/project/" + encodeURIComponent(state.folder) + "/archive/sizes");
+    for (const [mode, label] of Object.entries(labels)) {
+      const row = document.createElement("label");
+      row.className = "archive-mode";
+      const input = Object.assign(document.createElement("input"), { type: "radio", name: "archiveMode", value: mode, checked: mode === "timeline" });
+      input.addEventListener("change", () => archiveLink(mode));
+      const text = document.createElement("span");
+      text.textContent = label;
+      const size = document.createElement("b");
+      size.textContent = archiveSize(sizes[mode].bytes);
+      row.append(input, text, size);
+      modes.append(row);
+    }
+    archiveLink("timeline");
+    $("archiverGo").removeAttribute("aria-disabled");
+    $("archiverNote").textContent = "Takes left out can be rendered again from the zip: the shots, seeds and settings stay in it.";
+  } catch (error) {
+    $("archiverNote").textContent = error.message;
+  }
+});
+$("archiverClose").addEventListener("click", () => $("archiver").close());
+$("archiverGo").addEventListener("click", () => {
+  toast("The download starts in a moment. A large project keeps arriving for a while.");
+  setTimeout(() => $("archiver").close(), 300);
+});
+
+let archiveUpload = null;
+
+async function sendArchive(file) {
+  const id = [...crypto.getRandomValues(new Uint8Array(16))].map((b) => b.toString(16).padStart(2, "0")).join("");
+  const controller = new AbortController();
+  archiveUpload = controller;
+  const dialog = $("unarchiver");
+  $("unarchiverFile").textContent = file.name + ", " + archiveSize(file.size);
+  $("unarchiverBar").value = 0;
+  $("unarchiverNote").classList.remove("bad");
+  dialog.showModal();
+  const note = (text) => ($("unarchiverNote").textContent = text);
+  try {
+    let offset = 0;
+    let tries = 0;
+    while (offset < file.size || offset === 0) {
+      const part = file.slice(offset, offset + ARCHIVE_PART);
+      note("Uploading, " + archiveSize(offset) + " of " + archiveSize(file.size) + ".");
+      let response;
+      try {
+        response = await fetch("/h3take/api/archive/part?id=" + id + "&offset=" + offset,
+          { method: "POST", body: part, headers: { "Content-Type": "application/octet-stream" }, signal: controller.signal });
+      } catch (error) {
+        if (controller.signal.aborted) throw error;
+        if (++tries > 4) throw new Error("The upload kept failing. Check the connection and try again.");
+        await new Promise((resolve) => setTimeout(resolve, 1500 * tries));
+        continue;
+      }
+      const reply = await response.json().catch(() => ({}));
+      if (response.status === 409 && typeof reply.have === "number") {
+        offset = reply.have;
+        continue;
+      }
+      if (!response.ok) throw new Error(reply.error || "The upload failed (" + response.status + ").");
+      offset = reply.have;
+      tries = 0;
+      $("unarchiverBar").value = file.size ? offset / file.size : 1;
+      if (!file.size) break;
+    }
+    note("Unpacking the project. A large one takes a moment.");
+    $("unarchiverBar").removeAttribute("value");
+    const opened = await postJson("/archive/open", { id, client_id: clientId });
+    archiveUpload = null;
+    dialog.close();
+    await refreshProjects(opened.folder);
+    await openProject(opened.folder);
+    toast("Opened " + (opened.project.name || opened.folder) + ".");
+  } catch (error) {
+    if (controller.signal.aborted) return;
+    $("unarchiverNote").classList.add("bad");
+    note(error.message);
+  } finally {
+    archiveUpload = null;
+  }
+}
+
+$("projectUpload").addEventListener("click", async () => {
+  await flush();
+  $("archiveFile").value = "";
+  $("archiveFile").click();
+});
+$("archiveFile").addEventListener("change", () => {
+  const file = $("archiveFile").files[0];
+  if (file) sendArchive(file);
+});
+$("unarchiverClose").addEventListener("click", () => $("unarchiver").close());
+$("unarchiver").addEventListener("close", () => archiveUpload?.abort());
+
 $("newClip").addEventListener("click", addClip);
 $("addCast").addEventListener("click", addCastMember);
 $("addVoice").addEventListener("click", addVoiceMember);
