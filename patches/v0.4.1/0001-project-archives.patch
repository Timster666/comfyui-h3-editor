+
+
+def project():
+    return {
+        "name": "Scene", "revision": 7, "pending": [{"clip": "c00000001"}],
+        "cast": [{"id": "m1", "pictures": [{"file": "a.png", "subfolder": "h3take_projects/Scene/assets"}]}],
+        "clips": [
+            {"id": "c00000001", "takes": [take("c00000001", "t0000000a"), take("c00000001", "t0000000b")], "active": "t0000000a"},
+            {"id": "c00000002", "takes": [take("c00000002", "t0000000c")], "active": "t0000000c"},
+            {"id": "c00000003", "takes": [take("c00000003", "t0000000d", "footage")], "active": "t0000000d"},
