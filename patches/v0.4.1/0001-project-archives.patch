+        names = project_folders()
+        taken = {n.lower() for n in names}
+        wanted = body.get("name") or data.get("name") or old or "Imported project"
+        title = store.clean_title(wanted)
+        if store.slug(title).lower() in taken or os.path.exists(os.path.join(root(), store.slug(title))):
+            title = store.copy_name(title, names)
+        made = store.slug(title)
+        if made.lower() in taken or os.path.exists(os.path.join(root(), made)):
